{
  "name": "retenure-digital-journeys",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build ui && ng build && node tools/check-dist.mjs",
    "lint": "eslint . && stylelint \"**/*.{css,scss}\" --allow-empty-input && node tools/check-journey-templates.mjs && node tools/check-ui-files.mjs",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && ngc -p projects/ui/tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p projects/ui/tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json",
    "test": "ng test app --watch=false && ng test ui --watch=false && node --test \"tools/*.test.mjs\"",
    "e2e": "playwright test",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^24.19.2",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-import-x": "^4.18.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
